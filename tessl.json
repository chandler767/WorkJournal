{
  "name": "chandler-agent/testing",
  "mode": "vendored",
  "dependencies": {
    "tessl-academy/skill-foundations": {
      "version": "0.1.9"
    },
    "obra/superpowers": {
      "version": "8ca22dba9a94f28898bbce59f2537ff4d87c747d",
      "source": "https://github.com/obra/superpowers"
    },
    "local/work-journal": {
      "source": "file:./work-journal/skills/work-journal"
    },
    "chandler-playground/git-hygiene": {
      "source": "file:./plugins/git-hygiene"
    },
    "tessl-academy/tuning-your-agent": {
      "version": "0.1.4"
    },
    "tessl-academy/code-review-loops": {
      "version": "0.1.0"
    },
    "tessl-labs/factory-setup": {
      "version": "0.8.1"
    }
  },
  "agents": [
    "cursor",
    "codex",
    "claude-code"
  ],
  "verify": {
    "groups": {
      "media-runner": {
        "path": "verifiers/media-runner.json",
        "level": "error",
        "include": [
          "work-journal/internal/media/*.go"
        ],
        "exclude": [
          "work-journal/internal/media/exec.go",
          "work-journal/internal/media/*_test.go"
        ]
      }
    }
  },
  "actions": {
    "implement-github-issue": {
      "skill": "tessl-labs/factory#implement-github-issue",
      "environment": "WorkJournal-factory",
      "agent": "claude",
      "model": "claude-opus-5-5"
    },
    "shepherd": {
      "skill": "tessl-labs/factory#shepherd",
      "environment": "WorkJournal-factory",
      "agent": "claude",
      "model": "claude-opus-5-5"
    },
    "follow-ticket-changes": {
      "skill": "tessl-labs/factory#follow-ticket-changes",
      "environment": "WorkJournal-factory",
      "agent": "codex",
      "model": "gpt-6-luna"
    },
    "weekly-plan": {
      "skill": "file:tessl-factory#weekly-plan",
      "environment": "WorkJournal-factory",
      "agent": "claude",
      "model": "claude-opus-5-5"
    }
  },
  "triggers": {
    "github-issue-labelled": {
      "on": [
        "github:issues.labeled"
      ],
      "when": {
        "event.label.name": "tessl",
        "event.sender.type": "User",
        "event.sender.id": 1478812
      },
      "concurrency": {
        "keys": [
          {
            "key": "implement:{{ event.repository.id }}#{{ event.issue.number }}",
            "limit": 1
          }
        ]
      },
      "action": "implement-github-issue"
    },
    "shepherd-pr-review": {
      "on": [
        "github:pull_request_review.submitted"
      ],
      "when": {
        "event.pull_request.labels.*.name": {
          "any": {
            "equals": "tessl"
          }
        },
        "event.pull_request.head.ref": {
          "matches": "^tessl/"
        },
        "event.sender.login": {
          "not": {
            "equals": "tessl-app[bot]"
          }
        }
      },
      "concurrency": {
        "debounce": "90s",
        "keys": [
          {
            "key": "shepherd:{{ event.pull_request.number }}",
            "limit": 1
          }
        ]
      },
      "action": "shepherd"
    },
    "shepherd-pr-review-comment": {
      "on": [
        "github:pull_request_review_comment.created"
      ],
      "when": {
        "event.pull_request.labels.*.name": {
          "any": {
            "equals": "tessl"
          }
        },
        "event.pull_request.head.ref": {
          "matches": "^tessl/"
        },
        "event.sender.type": {
          "not": {
            "equals": "Bot"
          }
        }
      },
      "concurrency": {
        "debounce": "90s",
        "keys": [
          {
            "key": "shepherd:{{ event.pull_request.number }}",
            "limit": 1
          }
        ]
      },
      "action": "shepherd"
    },
    "shepherd-pr-comment": {
      "on": [
        "github:issue_comment.created"
      ],
      "when": {
        "isPullRequest": "true",
        "event.issue.labels.*.name": {
          "any": {
            "equals": "tessl"
          }
        },
        "event.sender.type": {
          "not": {
            "equals": "Bot"
          }
        }
      },
      "concurrency": {
        "debounce": "90s",
        "keys": [
          {
            "key": "shepherd:{{ event.issue.number }}",
            "limit": 1
          }
        ]
      },
      "action": "shepherd"
    },
    "shepherd-checks-failed": {
      "on": [
        "github:check_run.completed"
      ],
      "when": {
        "event.check_run.pull_requests.0.number": {
          "exists": true
        },
        "event.check_run.check_suite.head_branch": {
          "matches": "^tessl/"
        },
        "event.check_run.conclusion": {
          "in": [
            "failure",
            "timed_out",
            "startup_failure",
            "action_required"
          ]
        }
      },
      "concurrency": {
        "debounce": "90s",
        "keys": [
          {
            "key": "shepherd:{{ event.check_run.pull_requests.0.number }}",
            "limit": 1
          }
        ]
      },
      "action": "shepherd"
    },
    "shepherd-checks-passed": {
      "on": [
        "github:check_suite.completed"
      ],
      "when": {
        "event.check_suite.pull_requests.0.number": {
          "exists": true
        },
        "event.check_suite.head_branch": {
          "matches": "^tessl/"
        },
        "event.check_suite.conclusion": "success"
      },
      "concurrency": {
        "debounce": "90s",
        "keys": [
          {
            "key": "shepherd:{{ event.check_suite.pull_requests.0.number }}",
            "limit": 1
          }
        ]
      },
      "action": "shepherd"
    },
    "follow-ticket-changes-github-taken-back": {
      "on": [
        "github:issues.unlabeled"
      ],
      "when": {
        "event.label.name": "tessl",
        "event.sender.type": {
          "not": {
            "equals": "Bot"
          }
        }
      },
      "concurrency": {
        "keys": [
          {
            "key": "follow-ticket-changes:{{ event.repository.id }}#{{ event.issue.number }}",
            "limit": 1
          }
        ]
      },
      "action": {
        "use": "follow-ticket-changes",
        "inputs": {
          "TICKET_CHANGE": "taken-back"
        }
      }
    },
    "follow-ticket-changes-github-ended": {
      "on": [
        "github:issues.closed"
      ],
      "when": {
        "event.issue.labels.*.name": {
          "any": {
            "equals": "tessl"
          }
        }
      },
      "concurrency": {
        "keys": [
          {
            "key": "follow-ticket-changes:{{ event.repository.id }}#{{ event.issue.number }}",
            "limit": 1
          }
        ]
      },
      "action": {
        "use": "follow-ticket-changes",
        "inputs": {
          "TICKET_CHANGE": "issue-ended"
        }
      }
    },
    "follow-ticket-changes-github-replied": {
      "on": [
        "github:issue_comment.created"
      ],
      "when": {
        "isPullRequest": "false",
        "event.issue.state": "open",
        "event.issue.labels.*.name": {
          "any": {
            "equals": "tessl"
          }
        },
        "event.sender.type": "User"
      },
      "concurrency": {
        "keys": [
          {
            "key": "implement:{{ event.repository.id }}#{{ event.issue.number }}",
            "limit": 1
          }
        ]
      },
      "action": {
        "use": "follow-ticket-changes",
        "inputs": {
          "TICKET_CHANGE": "replied"
        }
      }
    },
    "follow-ticket-changes-pr-closed": {
      "on": [
        "github:pull_request.closed"
      ],
      "when": {
        "event.pull_request.labels.*.name": {
          "any": {
            "equals": "tessl"
          }
        },
        "event.pull_request.head.ref": {
          "matches": "^tessl/"
        }
      },
      "concurrency": {
        "keys": [
          {
            "key": "follow-ticket-changes:{{ event.repository.id }}#{{ event.pull_request.number }}",
            "limit": 1
          }
        ]
      },
      "action": {
        "use": "follow-ticket-changes",
        "inputs": {
          "TICKET_CHANGE": "pr-closed"
        }
      }
    }
  },
  "schedules": {
    "weekly-plan": {
      "cron": "0 9 * * 1",
      "timezone": "America/New_York",
      "description": "Every Monday at 9:00 New York time, post the weekly plan on the pinned Weekly plan issue.",
      "action": "weekly-plan"
    }
  }
}
