{
  "name": "testing",
  "mode": "vendored",
  "dependencies": {
    "tessl-academy/skill-foundations": {
      "version": "0.1.9"
    },
    "obra/superpowers": {
      "version": "8ca22dba9a94f28898bbce59f2537ff4d87c747d",
      "source": "https://github.com/obra/superpowers"
    },
    "local/work-journal": {
      "source": "file:./work-journal/skills/work-journal"
    },
    "chandler-playground/git-hygiene": {
      "version": "0.1.1"
    },
    "tessl-academy/tuning-your-agent": {
      "version": "0.1.4"
    }
  },
  "agents": [
    "cursor",
    "codex",
    "claude-code"
  ],
  "verify": {
    "groups": {
      "media-runner": {
        "path": "verifiers/media-runner.json",
        "level": "error",
        "include": [
          "work-journal/internal/media/*.go"
        ],
        "exclude": [
          "work-journal/internal/media/exec.go",
          "work-journal/internal/media/*_test.go"
        ]
      }
    }
  }
}
